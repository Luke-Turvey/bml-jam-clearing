\def\defineCMYKcolor(#1,#2,#3,#4)#5{%
    \pgfmathsetmacro{\myc}{#1/255}%
    \pgfmathsetmacro{\mym}{#2/255}%
    \pgfmathsetmacro{\myy}{#3/255}%
    \pgfmathsetmacro{\myk}{#4/255}%
    \definecolor{#5}{cmyk}{\myc,\mym,\myy,\myk}%
}

\defineCMYKcolor(100,0,0,0){cblue}
\defineCMYKcolor(0,100,100,0){cred}

\newcommand{\uc}[2]{\draw[draw=white, fill = cblue] (#1,#2) rectangle ++(0.6,0.6) node[pos=.5] {$\ua$};}
\newcommand{\rc}[2]{\draw[draw=white, fill = cred] (#1,#2) rectangle ++(0.6,0.6) node[pos=.5,yshift=-0.25mm] {$\ra$};}

